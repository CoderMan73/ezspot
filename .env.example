# Root environment template for Docker Compose.
# Copy to .env and fill with real values.

# BACKEND variables
DB_HOST=database
DB_NAME=testdb # also used for mysql
DB_USER=user1  # also used for mysql
DB_PASSWORD=replace-me # also used for mysql app user
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://22012s26-ezspot.discovery.cs.vt.edu

# MySQL variables
ROOT_PASSWORD=replace-me
# To log in to adminer:
# server = DB_HOST
# username = DB_USER
# password = DB_PASSWORD
# database = DB_HOST

# Auth variables
FRONTEND_URL=http://localhost:3000 # url to frontend
CAS_LOGOUT_URL=https://login.vt.edu/profile/cas/logout # url to VT CAS logout
LOCAL_DEV_USER=dev-local # name of user when in local dev environment
CAS_SSO_BASE_URL=https://login.vt.edu/profile/cas # base url to VT CAS
CAS_SERVER_BASE_URL=http://localhost:5000 # public backend base URL used to generate the CAS service callback URL
CAS_VALIDATE_URL=/serviceValidate # CAS ticket-validation path appended to CAS_SSO_BASE_URL
SESSION_SECRET=replace-me-with-a-long-secret # Used to sign cookie secrets

# Variable for kubernetes deployment
IMAGE_TAG=frontend-test