# Discovery deployment environment template.
# Copy to .env.discovery and set real secret values before deploy.

# Backend/runtime variables
DB_HOST=database
DB_NAME=testdb
DB_USER=user1
DB_PASSWORD=replace-me

# CORS must include deployed frontend origin
CORS_ALLOWED_ORIGINS=https://22012s26-ezspot.discovery.cs.vt.edu

# MySQL variables
ROOT_PASSWORD=replace-me

# Auth variables (deployed)
FRONTEND_URL=https://22012s26-ezspot.discovery.cs.vt.edu
CAS_LOGOUT_URL=https://login.vt.edu/profile/cas/logout
LOCAL_DEV_USER=dev-local
CAS_SSO_BASE_URL=https://login.vt.edu/profile/cas
CAS_SERVER_BASE_URL=https://22012s26-ezspot.discovery.cs.vt.edu
CAS_VALIDATE_URL=/serviceValidate
SESSION_SECRET=replace-me-with-a-long-secret

# Image tag used by kubernetes/scripts/deploy.ps1
IMAGE_TAG=frontend-test
